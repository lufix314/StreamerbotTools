{
  "name": "streamerbot_tools",
  "version": "0.7.1",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "rm -rf build/* && node esbuild.config.js",
    "dev": "node esbuild.config.js watch & http-server --port 3000 build",
    "clean": "rm -rf build/*"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "esbuild-plugin-alias": "^0.2.1",
    "http-server": "^14.1.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@streamerbot/client": "^2.0.1"
  }
}
